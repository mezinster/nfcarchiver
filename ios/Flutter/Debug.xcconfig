#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Signing entitlements, indirected through a variable so a local build can drop
// them without touching a tracked file.
//
// Runner.entitlements requests com.apple.developer.nfc.readersession.formats.
// A free Apple ID signs as a "Personal Team", and Personal Teams cannot enable
// Near Field Communication Tag Reading — Xcode refuses to create the profile,
// so the build fails at signing before the app ever launches.
//
// That matters because the Chameleon reader path needs no NFC entitlement at
// all: it is Core Bluetooth end to end, and it is iOS's ONLY route to Mifare
// Classic (Core NFC has no CRYPTO1). Blanking this variable therefore buys a
// fully working reader build on a free account, losing only the phone's own
// NFC radio — which could not read Mifare Classic anyway.
//
// To use it, create ios/Flutter/LocalOverrides.xcconfig (gitignored) with:
//     NFAR_CODE_SIGN_ENTITLEMENTS =
//
// The include is last so the override wins, and it is DEBUG ONLY —
// Release.xcconfig deliberately has no such hook, so this workaround cannot
// follow anyone into a shipped build.
NFAR_CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements

// The app's identity, indirected for the same reason. A bundle ID can be
// registered to exactly one team. The original com.nfcarchiver.nfcArchiver
// belongs to an unrelated team, so even the paid team was refused it:
//
//   Failed Registering Bundle Identifier: the app identifier
//   "com.nfcarchiver.nfcArchiver" cannot be registered to your development
//   team because it is not available.
//
// Hence com.nfcarchiver.app, registered to the paid team. A free Personal Team
// cannot claim that one either, so overriding it locally is the only way onto
// a device without the paid programme. Anything but the real value must never ship: the App Store keys
// updates off the bundle ID, so a wrong one is not a bad build, it is a
// different app that existing users can never update to.
NFAR_BUNDLE_ID = com.nfcarchiver.app
// The paid team that signs and ships the app. Set here, never in the target
// settings of project.pbxproj: target settings beat xcconfig values and would
// override a free-team developer's LocalOverrides.xcconfig.
DEVELOPMENT_TEAM = C6LYTC662B
#include? "LocalOverrides.xcconfig"
